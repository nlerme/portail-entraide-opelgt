[Unit]
Description=Portail Entraide Opel GT - mise à jour des petites annonces
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=opelgt
Group=opelgt
WorkingDirectory=/opt/portail-entraide-opel-gt
Environment=PORTAIL_CONFIG=/etc/portail-entraide-opel-gt/config.json
Environment=PORTAIL_SECRETS=/etc/portail-entraide-opel-gt/secrets.json
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/portail-entraide-opel-gt/venv-web/bin/python -m app.annonces.service
TimeoutStartSec=15min
KillMode=control-group
Nice=5
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/portail-entraide-opel-gt
UMask=0027
