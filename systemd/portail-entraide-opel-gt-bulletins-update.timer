[Unit]
Description=Portail Entraide Opel GT - bulletins chaque dimanche à 02h00

[Timer]
OnCalendar=Sun *-*-* 02:00:00 Europe/Paris
# The last Sunday in March has no 02:00 in Paris; catch that occurrence at 03:00.
OnCalendar=Sun *-03-25..31 03:00:00 Europe/Paris
Persistent=true
AccuracySec=1s
RandomizedDelaySec=0
Unit=portail-entraide-opel-gt-bulletins-update.service

[Install]
WantedBy=timers.target
