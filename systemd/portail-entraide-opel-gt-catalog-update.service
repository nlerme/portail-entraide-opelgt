[Unit]
Description=Portail Entraide Opel GT - mise en file des catalogues
After=network-online.target

[Service]
Type=oneshot
User=opelgt
Group=opelgt
WorkingDirectory=/opt/portail-entraide-opel-gt
Environment=PORTAIL_CONFIG=/etc/portail-entraide-opel-gt/config.json
Environment=PORTAIL_SECRETS=/etc/portail-entraide-opel-gt/secrets.json
ExecStart=/opt/portail-entraide-opel-gt/venv-web/bin/python -m app.manage enqueue-catalogs
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/portail-entraide-opel-gt
